## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ins.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# Visual Studio cache/options directory
.vs/

# Build results
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Bb]in/
[Oo]bj/

# SQLite databases (Ignore local data, let the app generate an empty DB)
*.db
*.sqlite
*.sqlite3

# Obfuscar logs/outputs
Mapping.txt

# Inno Setup output
Installer/
Output/
*.exe

# Publish folders
publish/

# Log files
*.log
PosAppCrashLog.txt

# Gemini Agent Configuration
.agents/
