<UserControl x:Class="PosApp.Views.ClosingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource ColorSurfaceContainerLowest}" FontFamily="{DynamicResource FontBody}">

    <UserControl.Resources>
        <!-- Blue Gradient for X-Report -->
        <LinearGradientBrush x:Key="GradientXReport" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F0F9FF" Offset="0"/>
            <GradientStop Color="#FFFFFF" Offset="1"/>
        </LinearGradientBrush>

        <!-- Gray/Tertiary Gradient for Z-Report -->
        <LinearGradientBrush x:Key="GradientZReport" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F1F5F9" Offset="0"/>
            <GradientStop Color="#FFFFFF" Offset="1"/>
        </LinearGradientBrush>
    </UserControl.Resources>

    <Grid Margin="24">
        <!-- İŞLEMLER PANELİ (Ortalanmış) -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="450">
            <!-- X-Raporu Kartı -->
            <Border Background="{StaticResource GradientXReport}" BorderBrush="{DynamicResource ColorOutlineVariant}" BorderThickness="1" CornerRadius="12" Padding="24" Margin="0 0 0 24" Height="260" ClipToBounds="True">
                <Border.Effect><DropShadowEffect Color="#E1E5EB" BlurRadius="6" ShadowDepth="1" Opacity="0.5"/></Border.Effect>
                <Grid>
                    <!-- Background Icon Decoration -->
                    <TextBlock Text="📄" FontSize="120" Foreground="#38bdf8" Opacity="0.1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0 -20 -20 0"/>
                    
                    <StackPanel>
                        <TextBlock Text="Ara Rapor" FontFamily="{DynamicResource FontHeadline}" FontSize="24" FontWeight="Bold" Foreground="#0284c7" Margin="0 0 0 8"/>
                        <TextBlock Text="Gün içindeki satışlarınızı ve mevcut durumu kilitlenmeden anlık olarak görüntüleyin." Foreground="{DynamicResource ColorOnSurfaceVariant}" FontSize="14" TextWrapping="Wrap" Margin="0 0 0 24"/>
                        
                        <!-- Spacer to push button to bottom -->
                        <Border Height="30"/>
                        
                        <Button Height="48" Command="{Binding GenerateXReportCommand}" BorderThickness="0" VerticalAlignment="Bottom">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="#38bdf8" CornerRadius="8" x:Name="Bg">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="📄 " Foreground="White" FontSize="16"/>
                                            <TextBlock Text="X-RAPORU AL" Foreground="White" FontSize="16" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="#0284c7"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Z-Raporu Kartı -->
            <Border Background="{StaticResource GradientZReport}" BorderBrush="{DynamicResource ColorOutlineVariant}" BorderThickness="1" CornerRadius="12" Padding="24" Height="260" ClipToBounds="True">
                <Border.Effect><DropShadowEffect Color="#E1E5EB" BlurRadius="6" ShadowDepth="1" Opacity="0.5"/></Border.Effect>
                <Grid>
                    <!-- Background Icon Decoration -->
                    <TextBlock Text="🔒" FontSize="120" Foreground="{DynamicResource ColorTertiary}" Opacity="0.1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0 -20 -20 0"/>
                    
                    <StackPanel>
                        <TextBlock Text="Gün Sonu Kapanışı" FontFamily="{DynamicResource FontHeadline}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource ColorTertiary}" Margin="0 0 0 8"/>
                        <TextBlock Text="Günü sonlandırın, kasayı sayın ve bugünün tüm satışlarını arşivleyerek kilitleyin." Foreground="{DynamicResource ColorOnSurfaceVariant}" FontSize="14" TextWrapping="Wrap" Margin="0 0 0 24"/>
                        
                        <!-- Spacer to push button to bottom -->
                        <Border Height="30"/>
                        
                        <Button Height="48" Command="{Binding GenerateZReportCommand}" BorderThickness="0" VerticalAlignment="Bottom">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{DynamicResource ColorTertiary}" CornerRadius="8" x:Name="Bg">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="🔒 " Foreground="White" FontSize="16"/>
                                            <TextBlock Text="Z-RAPORU AL (KAPANIŞ)" Foreground="White" FontSize="16" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="#0f172a"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
