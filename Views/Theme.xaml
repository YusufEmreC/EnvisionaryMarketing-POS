<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ELITEPOS DESIGN SYSTEM (DESIGN.md) -->

    <!-- Core Colors -->
    <SolidColorBrush x:Key="ColorPrimary" Color="#1A73E8"/>
    <SolidColorBrush x:Key="ColorPrimaryHover" Color="#1557B0"/>
    <SolidColorBrush x:Key="ColorBackground" Color="#FAF7F2"/>
    <SolidColorBrush x:Key="ColorSurface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ColorBorder" Color="#E8E3DA"/>
    
    <!-- Semantic Colors -->
    <SolidColorBrush x:Key="ColorSuccess" Color="#266427"/>
    <SolidColorBrush x:Key="ColorWarning" Color="#E65100"/>
    <SolidColorBrush x:Key="ColorError" Color="#EA4335"/>
    <SolidColorBrush x:Key="ColorAccentSage" Color="#8AA890"/>
    
    <!-- Text Colors -->
    <SolidColorBrush x:Key="ColorTextPrimary" Color="#1F1F1B"/>
    <SolidColorBrush x:Key="ColorTextSecondary" Color="#6B6B65"/>
    
    <!-- Legacy compatibility mapped to new tokens (so we don't break unedited views immediately) -->
    <SolidColorBrush x:Key="ColorSurfaceContainerLowest" Color="#FAF7F2"/>
    <SolidColorBrush x:Key="ColorSurfaceContainerHigh" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ColorOutlineVariant" Color="#E8E3DA"/>
    <SolidColorBrush x:Key="ColorOnSurface" Color="#1F1F1B"/>
    <SolidColorBrush x:Key="ColorOnSurfaceVariant" Color="#6B6B65"/>
    <SolidColorBrush x:Key="ColorOnPrimary" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ColorSecondaryContainer" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ColorOnSecondaryContainer" Color="#1A73E8"/>
    <SolidColorBrush x:Key="ColorSecondary" Color="#1A73E8"/>
    <SolidColorBrush x:Key="ColorTertiary" Color="#8AA890"/>

    <!-- Typography -->
    <!-- We use Inter as the main family, fallback to Segoe UI -->
    <FontFamily x:Key="FontBody">Inter, Segoe UI, sans-serif</FontFamily>
    <FontFamily x:Key="FontHeadline">Inter, Segoe UI, sans-serif</FontFamily>

    <!-- Component Tokens (Corner Radius & Thickness) -->
    <CornerRadius x:Key="RadiusSm">4</CornerRadius>
    <CornerRadius x:Key="RadiusMd">8</CornerRadius>
    <CornerRadius x:Key="RadiusLg">12</CornerRadius>
    <CornerRadius x:Key="RadiusXl">16</CornerRadius>
    <Thickness x:Key="TouchPadding">16</Thickness>

    <!-- Base TextBlock -->
    <Style TargetType="TextBlock" x:Key="BaseTextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontBody}"/>
        <Setter Property="Foreground" Value="{StaticResource ColorTextPrimary}"/>
    </Style>

    <!-- Action Button (Min 48px, ideal 56px, CornerRadius 8px) -->
    <Style TargetType="Button" x:Key="PrimaryButtonStyle">
        <Setter Property="Background" Value="{StaticResource ColorPrimary}"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="FontFamily" Value="{StaticResource FontBody}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="MinHeight" Value="48"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="{StaticResource RadiusMd}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource ColorPrimaryHover}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="{StaticResource ColorBorder}"/>
                            <Setter Property="Foreground" Value="{StaticResource ColorTextSecondary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Success Button (PAY NOW) -->
    <Style TargetType="Button" x:Key="SuccessButtonStyle" BasedOn="{StaticResource PrimaryButtonStyle}">
        <Setter Property="Background" Value="{StaticResource ColorSuccess}"/>
        <Setter Property="MinHeight" Value="56"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="{StaticResource RadiusMd}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#1C4B1D"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Error Button -->
    <Style TargetType="Button" x:Key="ErrorButtonStyle" BasedOn="{StaticResource PrimaryButtonStyle}">
        <Setter Property="Background" Value="{StaticResource ColorError}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="{StaticResource RadiusMd}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#C2291E"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Outline/Secondary Button -->
    <Style TargetType="Button" x:Key="OutlineButtonStyle">
        <Setter Property="Background" Value="{StaticResource ColorSurface}"/>
        <Setter Property="Foreground" Value="{StaticResource ColorTextPrimary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ColorBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily" Value="{StaticResource FontBody}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="MinHeight" Value="48"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource RadiusMd}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource ColorBackground}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Touch Target Input Box (Min 48px) -->
    <Style TargetType="TextBox" x:Key="ModernTextBoxStyle">
        <Setter Property="Background" Value="{StaticResource ColorSurface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ColorBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource ColorTextPrimary}"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="MinHeight" Value="48"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontFamily" Value="{StaticResource FontBody}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border CornerRadius="{StaticResource RadiusMd}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource ColorPrimary}"/>
                            <Setter Property="BorderThickness" Value="2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Sidebar Active Button -->
    <Style TargetType="Button" x:Key="SidebarActiveButtonStyle">
        <Setter Property="Background" Value="{StaticResource ColorSurface}"/>
        <Setter Property="Foreground" Value="{StaticResource ColorPrimary}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontHeadline}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="MinHeight" Value="48"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="{StaticResource RadiusLg}" Padding="{TemplateBinding Padding}" Margin="4 2">
                        <Grid>
                            <Border Width="4" Background="{StaticResource ColorPrimary}" CornerRadius="2" HorizontalAlignment="Left" Margin="-12 8 0 8"/>
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Sidebar Inactive Button -->
    <Style TargetType="Button" x:Key="SidebarInactiveButtonStyle">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource ColorTextSecondary}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontHeadline}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="MinHeight" Value="48"/>
        <Setter Property="Padding" Value="16,0"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="{StaticResource RadiusLg}" Padding="{TemplateBinding Padding}" Margin="4 2">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#F2EDE4"/>
                            <Setter Property="Foreground" Value="{StaticResource ColorTextPrimary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
