<Window x:Class="PosApp.Views.ZReportCardDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Z-Raporu Görüntüleyici" Height="650" Width="500"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Border Background="{DynamicResource ColorSurface}" BorderBrush="{DynamicResource ColorOutlineVariant}" BorderThickness="1" CornerRadius="16" Margin="16" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect Color="#94a3b8" BlurRadius="15" ShadowDepth="4" Opacity="0.4"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Border Grid.Row="0" Background="{DynamicResource ColorPrimary}" CornerRadius="16 16 0 0" Padding="20">
                <Grid>
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Z-Raporu Detayları" FontFamily="{DynamicResource FontHeadline}" FontSize="24" FontWeight="Bold" Foreground="White"/>
                        <TextBlock x:Name="TxtReportDate" Text="Tarih: --" FontFamily="{DynamicResource FontBody}" FontSize="14" Foreground="#e0f2fe" Margin="0 4 0 0"/>
                        <Border Background="#0284c7" HorizontalAlignment="Left" CornerRadius="6" Padding="8 4" Margin="0 8 0 0">
                            <TextBlock x:Name="TxtReportNo" Text="#0" FontWeight="Bold" Foreground="White" FontSize="12"/>
                        </Border>
                    </StackPanel>
                    
                    <Button HorizontalAlignment="Right" VerticalAlignment="Top" Width="32" Height="32" Content="✕" FontSize="18" Foreground="White" Background="Transparent" BorderThickness="0" Click="BtnClose_Click" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="16">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- CONTENT -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24">
                <StackPanel>
                    <!-- SATIŞLAR KARTI -->
                    <Border Background="#f0f9ff" BorderBrush="#bae6fd" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0 0 0 16">
                        <StackPanel>
                            <TextBlock Text="💰 SATIŞLAR" FontWeight="Bold" Foreground="#0369a1" FontSize="14" Margin="0 0 0 12"/>
                            
                            <Grid Margin="0 0 0 8">
                                <TextBlock Text="Nakit Satış" Foreground="#475569"/>
                                <TextBlock x:Name="TxtCashSales" Text="₺0.00" FontWeight="SemiBold" HorizontalAlignment="Right" Foreground="#0f172a"/>
                            </Grid>
                            <Grid Margin="0 0 0 8">
                                <TextBlock Text="Kartlı Satış" Foreground="#475569"/>
                                <TextBlock x:Name="TxtCreditSales" Text="₺0.00" FontWeight="SemiBold" HorizontalAlignment="Right" Foreground="#0f172a"/>
                            </Grid>
                            
                            <Rectangle Height="1" Fill="#bae6fd" Margin="0 8"/>
                            
                            <Grid>
                                <TextBlock Text="TOPLAM SATIŞ" FontWeight="Bold" Foreground="#0369a1"/>
                                <TextBlock x:Name="TxtTotalSales" Text="₺0.00" FontWeight="Bold" FontSize="16" HorizontalAlignment="Right" Foreground="#0369a1"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- İADELER & GİDERLER KARTI -->
                    <Border Background="#fff1f2" BorderBrush="#fecdd3" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0 0 0 16">
                        <StackPanel>
                            <TextBlock Text="📉 İADELER VE GİDERLER" FontWeight="Bold" Foreground="#be123c" FontSize="14" Margin="0 0 0 12"/>
                            
                            <Grid Margin="0 0 0 8">
                                <TextBlock Text="Nakit İade" Foreground="#475569"/>
                                <TextBlock x:Name="TxtCashRefunds" Text="- ₺0.00" FontWeight="SemiBold" HorizontalAlignment="Right" Foreground="#9f1239"/>
                            </Grid>
                            <Grid Margin="0 0 0 8">
                                <TextBlock Text="Kart İade" Foreground="#475569"/>
                                <TextBlock x:Name="TxtCreditRefunds" Text="- ₺0.00" FontWeight="SemiBold" HorizontalAlignment="Right" Foreground="#9f1239"/>
                            </Grid>
                            <Grid Margin="0 0 0 8">
                                <TextBlock Text="Giderler (Masraf)" Foreground="#475569"/>
                                <TextBlock x:Name="TxtExpenses" Text="- ₺0.00" FontWeight="SemiBold" HorizontalAlignment="Right" Foreground="#9f1239"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- KASA DURUMU KARTI -->
                    <Border Background="#f8fafc" BorderBrush="#e2e8f0" BorderThickness="1" CornerRadius="12" Padding="20">
                        <StackPanel>
                            <TextBlock Text="💵 KASA DURUMU (SADECE NAKİT)" FontWeight="Bold" Foreground="#334155" FontSize="14" Margin="0 0 0 12"/>
                            
                            <Grid Margin="0 0 0 8">
                                <TextBlock Text="Açılış Kasası" Foreground="#475569"/>
                                <TextBlock x:Name="TxtOpeningCash" Text="₺0.00" FontWeight="SemiBold" HorizontalAlignment="Right" Foreground="#0f172a"/>
                            </Grid>
                            <Grid Margin="0 0 0 8">
                                <TextBlock Text="Beklenen Nakit" Foreground="#475569"/>
                                <TextBlock x:Name="TxtExpectedCash" Text="₺0.00" FontWeight="SemiBold" HorizontalAlignment="Right" Foreground="#0f172a"/>
                            </Grid>
                            <Grid Margin="0 0 0 8">
                                <TextBlock Text="Sayılan Nakit" Foreground="#475569"/>
                                <TextBlock x:Name="TxtCountedCash" Text="₺0.00" FontWeight="SemiBold" HorizontalAlignment="Right" Foreground="#0f172a"/>
                            </Grid>
                            
                            <Rectangle Height="1" Fill="#e2e8f0" Margin="0 8"/>
                            
                            <Grid>
                                <TextBlock Text="KASA FARKI" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                                <Border x:Name="BadgeDifference" Background="#f1f5f9" CornerRadius="6" Padding="12 6" HorizontalAlignment="Right">
                                    <TextBlock x:Name="TxtDifference" Text="₺0.00" FontWeight="Bold" FontSize="18" Foreground="#475569"/>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- FOOTER -->
            <Border Grid.Row="2" Background="{DynamicResource ColorSurfaceContainerLowest}" BorderThickness="0 1 0 0" BorderBrush="{DynamicResource ColorOutlineVariant}" Padding="24" CornerRadius="0 0 16 16">
                <Button Content="Fiş Olarak Yazdır" Click="BtnPrint_Click" Height="45" Background="#e2e8f0" Foreground="#0f172a" FontSize="16" FontWeight="Bold" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Border>
        </Grid>
    </Border>
</Window>
