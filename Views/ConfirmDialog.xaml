<Window x:Class="PosApp.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Onay" Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" Background="Transparent" 
        ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True" FontFamily="Segoe UI">
    
    <Border Background="White" CornerRadius="16" Margin="20" Padding="30">
        <Border.Effect><DropShadowEffect Color="#B0BEC5" BlurRadius="20" ShadowDepth="5" Opacity="0.4"/></Border.Effect>
        
        <StackPanel>
            <!-- Question Icon -->
            <Grid HorizontalAlignment="Center" Margin="0 0 0 20">
                <Ellipse Width="70" Height="70" Fill="#FFF9E6"/>
                <TextBlock Text="?" FontSize="36" FontWeight="Bold" Foreground="#F39C12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>

            <!-- Title -->
            <TextBlock x:Name="TxtTitle" Text="Onay" FontSize="22" FontWeight="Bold" Foreground="#2C3E50" HorizontalAlignment="Center" Margin="0 0 0 10"/>
            
            <!-- Message Body -->
            <TextBlock x:Name="TxtMessage" FontSize="16" Foreground="#7F8C8D" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" Margin="0 0 0 25" LineHeight="24"/>
            
            <Separator Background="#F4F6F9" Margin="0 0 0 20"/>
            
            <!-- Buttons -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <Button Grid.Column="0" Content="Onayla" Padding="0 15" Background="#0F7A59" Foreground="White" FontSize="16" FontWeight="Bold" BorderThickness="0" Margin="0 0 5 0" Click="BtnConfirm_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Cursor" Value="Hand"/>
                        </Style>
                    </Button.Style>
                </Button>

                <Button Grid.Column="1" Content="İptal Et" Padding="0 15" Background="#E74C3C" Foreground="White" FontSize="16" FontWeight="Bold" BorderThickness="0" Margin="5 0 0 0" Click="BtnCancel_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Cursor" Value="Hand"/>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </StackPanel>
    </Border>
</Window>
