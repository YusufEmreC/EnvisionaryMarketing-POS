<UserControl x:Class="PosApp.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="UserControl_Loaded"
             Background="{DynamicResource ColorSurfaceContainerLowest}" FontFamily="{DynamicResource FontBody}">
             
    <UserControl.Resources>
        <!-- Success Button Style -->
        <Style TargetType="Button" x:Key="SuccessButtonStyle">
            <Setter Property="Background" Value="{StaticResource ColorSuccess}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="{StaticResource FontBody}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#059669"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger Button Style -->
        <Style TargetType="Button" x:Key="DangerButtonStyle">
            <Setter Property="Background" Value="{StaticResource ColorError}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="{StaticResource FontBody}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#991B1B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <Style TargetType="Border" x:Key="StatCardStyle">
            <Setter Property="Background" Value="{StaticResource ColorSurfaceContainerLowest}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ColorOutlineVariant}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource ColorSurface}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource ColorPrimary}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="24">
        <StackPanel>
            
            <!-- ÜST BÖLÜM: Ürün Ekle / Düzenle Formu -->
            <Border BorderBrush="{DynamicResource ColorOutlineVariant}" BorderThickness="1" CornerRadius="12" Background="{DynamicResource ColorSurfaceContainerLowest}" Padding="24" Margin="0 0 0 16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0 0 0 24">
                        <TextBlock Text="➕ " Foreground="{DynamicResource ColorPrimary}" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Text="Barkodlu Ürün Ekle" FontFamily="{DynamicResource FontHeadline}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource ColorOnSurface}" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Row 1 -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0 0 16 16">
                            <TextBlock Text="BARKOD *" Foreground="{DynamicResource ColorOnSurfaceVariant}" FontSize="11" FontWeight="Bold" Margin="0 0 0 4"/>
                            <TextBox x:Name="TxtFormBarcode" Text="{Binding FormBarcode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBoxStyle}" Height="44"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0 0 16 16">
                            <TextBlock Text="ÜRÜN ADI *" Foreground="{DynamicResource ColorOnSurfaceVariant}" FontSize="11" FontWeight="Bold" Margin="0 0 0 4"/>
                            <TextBox x:Name="TxtFormName" Text="{Binding FormName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBoxStyle}" Height="44"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0 0 0 16">
                            <TextBlock Text="ALIŞ FİYATI (₺) *" Foreground="{DynamicResource ColorOnSurfaceVariant}" FontSize="11" FontWeight="Bold" Margin="0 0 0 4"/>
                            <TextBox x:Name="TxtFormBuyPrice" Text="{Binding FormBuyPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBoxStyle}" Height="44" GotFocus="TextBox_GotFocus" LostFocus="TextBox_LostFocus"/>
                        </StackPanel>

                        <!-- Row 2 -->
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0 0 16 16">
                            <TextBlock Text="SATIŞ FİYATI (₺) *" Foreground="{DynamicResource ColorOnSurfaceVariant}" FontSize="11" FontWeight="Bold" Margin="0 0 0 4"/>
                            <TextBox x:Name="TxtFormSellPrice" Text="{Binding FormSellPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBoxStyle}" Height="44" GotFocus="TextBox_GotFocus" LostFocus="TextBox_LostFocus"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0 0 16 16">
                            <TextBlock Text="STOK MİKTARI *" Foreground="{DynamicResource ColorOnSurfaceVariant}" FontSize="11" FontWeight="Bold" Margin="0 0 0 4"/>
                            <TextBox x:Name="TxtFormStock" Text="{Binding FormStock, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBoxStyle}" Height="44" GotFocus="TextBox_GotFocus" LostFocus="TextBox_LostFocus"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0 0 0 16">
                            <TextBlock Text="KATEGORİ" Foreground="{DynamicResource ColorOnSurfaceVariant}" FontSize="11" FontWeight="Bold" Margin="0 0 0 4"/>
                            <TextBox x:Name="TxtFormCategory" Text="{Binding FormCategory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBoxStyle}" Height="44"/>
                        </StackPanel>

                        <!-- Row 3 -->
                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0 0 16 16">
                            <TextBlock Text="KDV ORANI (%) *" Foreground="{DynamicResource ColorOnSurfaceVariant}" FontSize="11" FontWeight="Bold" Margin="0 0 0 4"/>
                            <TextBox x:Name="TxtFormKdvRate" Text="{Binding FormKdvRate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBoxStyle}" Height="44" GotFocus="TextBox_GotFocus" LostFocus="TextBox_LostFocus"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="0 0 16 16">
                            <TextBlock Text="SON KULLANIM TARİHİ" Foreground="{DynamicResource ColorOnSurfaceVariant}" FontSize="11" FontWeight="Bold" Margin="0 0 0 4"/>
                            <Border CornerRadius="8" BorderBrush="{DynamicResource ColorOutlineVariant}" BorderThickness="1" Background="{DynamicResource ColorSurface}" Height="44">
                                <DatePicker x:Name="DpFormExpiration" SelectedDate="{Binding FormExpirationDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Margin="8 0" Foreground="{DynamicResource ColorOnSurface}"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="2" Margin="0 0 0 16" VerticalAlignment="Center">
                            <CheckBox x:Name="ChkFormIsWeighed" IsChecked="{Binding FormIsWeighed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Content="Tartılı Ürün (Meyve/Sebze)" Foreground="{DynamicResource ColorOnSurface}" FontWeight="Bold" FontSize="12" Margin="4 24 0 0" VerticalAlignment="Center">
                                <CheckBox.LayoutTransform>
                                    <ScaleTransform ScaleX="1.2" ScaleY="1.2"/>
                                </CheckBox.LayoutTransform>
                            </CheckBox>
                        </StackPanel>
                        
                        <!-- Kaydet Butonu -->
                        <Button Grid.Row="3" Grid.ColumnSpan="3" Style="{DynamicResource PrimaryButtonStyle}" Height="44" Margin="0 8 0 0" Command="{Binding SaveProductCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💾 " FontSize="16" VerticalAlignment="Center"/>
                                <TextBlock Text="Ürünü Veritabanına Kaydet" FontSize="16" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- YENİ BÖLÜM: Hızlı Ürün Ekle Formu -->
            <Border BorderBrush="{DynamicResource ColorOutlineVariant}" BorderThickness="1" CornerRadius="12" Background="{DynamicResource ColorSurfaceContainerLowest}" Padding="24" Margin="0 0 0 16">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0 0 0 24">
                        <TextBlock Text="⚡ " Foreground="#F57C00" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Text="Barkodsuz / Hızlı Ürün Ekle" FontFamily="{DynamicResource FontHeadline}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource ColorOnSurface}" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0 0 16 0">
                            <TextBlock Text="ÜRÜN ADI *" Foreground="{DynamicResource ColorOnSurfaceVariant}" FontSize="11" FontWeight="Bold" Margin="0 0 0 4"/>
                            <TextBox x:Name="TxtQuickName" Text="{Binding QuickName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBoxStyle}" Height="44"/>
                        </StackPanel>
                        
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0 0 16 0">
                            <TextBlock Text="SATIŞ FİYATI (₺) *" Foreground="{DynamicResource ColorOnSurfaceVariant}" FontSize="11" FontWeight="Bold" Margin="0 0 0 4"/>
                            <TextBox x:Name="TxtQuickPrice" Text="{Binding QuickPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBoxStyle}" Height="44" GotFocus="TextBox_GotFocus" LostFocus="TextBox_LostFocus"/>
                        </StackPanel>
                        
                        <Button Grid.Row="0" Grid.Column="2" Style="{DynamicResource PrimaryButtonStyle}" Height="44" Width="150" VerticalAlignment="Bottom" Command="{Binding AddQuickProductCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="➕ " FontSize="16" VerticalAlignment="Center"/>
                                <TextBlock Text="Hızlı Ekle" FontSize="16" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        
                        <CheckBox x:Name="ChkQuickIsWeighed" IsChecked="{Binding QuickIsWeighed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" Grid.ColumnSpan="3" Content="Bu ürün tartılıdır (Meyve/Sebze vb.)" Foreground="{DynamicResource ColorOnSurface}" FontWeight="Bold" FontSize="12" Margin="0 16 0 0" VerticalAlignment="Center">
                            <CheckBox.LayoutTransform>
                                <ScaleTransform ScaleX="1.2" ScaleY="1.2"/>
                            </CheckBox.LayoutTransform>
                        </CheckBox>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ORTA BÖLÜM: İstatistik Kartları -->
            <Grid Margin="0 0 0 16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="CardTotalStock" Grid.Column="0" Style="{StaticResource StatCardStyle}" MouseLeftButtonDown="BorderTotal_MouseLeftButtonDown">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="TOPLAM ÜRÜN" Foreground="{DynamicResource ColorOnSurfaceVariant}" FontWeight="Bold" FontSize="11" Margin="0 0 0 4"/>
                            <TextBlock x:Name="TxtStatTotal" Text="{Binding Stats.TotalProducts}" Foreground="{DynamicResource ColorOnSurface}" FontFamily="{DynamicResource FontHeadline}" FontWeight="Bold" FontSize="32"/>
                        </StackPanel>
                        <Border Background="{DynamicResource ColorSurface}" CornerRadius="20" Width="40" Height="40" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="📦" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource ColorOutlineVariant}"/>
                        </Border>
                    </Grid>
                </Border>

                <Border x:Name="CardCriticalStock" Grid.Column="2" Style="{StaticResource StatCardStyle}" MouseLeftButtonDown="BorderCritical_MouseLeftButtonDown" BorderBrush="#FFDAD6">
                    <Grid>
                        <!-- Accent Line -->
                        <Border Width="4" HorizontalAlignment="Left" Background="{DynamicResource ColorError}" Margin="-16 -16 0 -16" CornerRadius="12 0 0 12"/>
                        <StackPanel Margin="12 0 0 0">
                            <TextBlock Text="KRİTİK STOK UYARISI" Foreground="{DynamicResource ColorError}" FontWeight="Bold" FontSize="11" Margin="0 0 0 4"/>
                            <TextBlock x:Name="TxtStatCritical" Text="{Binding Stats.CriticalStock}" Foreground="{DynamicResource ColorError}" FontFamily="{DynamicResource FontHeadline}" FontWeight="Bold" FontSize="32"/>
                        </StackPanel>
                        <Border Background="#FFDAD6" CornerRadius="20" Width="40" Height="40" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="⚠️" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource StatCardStyle}" Cursor="Arrow">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="KATEGORİ SAYISI" Foreground="{DynamicResource ColorOnSurfaceVariant}" FontWeight="Bold" FontSize="11" Margin="0 0 0 4"/>
                            <TextBlock x:Name="TxtStatCategories" Text="{Binding Stats.Categories}" Foreground="{DynamicResource ColorOnSurface}" FontFamily="{DynamicResource FontHeadline}" FontWeight="Bold" FontSize="32"/>
                        </StackPanel>
                        <Border Background="{DynamicResource ColorSurface}" CornerRadius="20" Width="40" Height="40" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="📂" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource ColorOutlineVariant}"/>
                        </Border>
                    </Grid>
                </Border>

                <Border x:Name="CardExpiringSoon" Grid.Column="6" Style="{StaticResource StatCardStyle}" MouseLeftButtonDown="BorderExpiringSoon_MouseLeftButtonDown" BorderBrush="#FFE0B2">
                    <Grid>
                        <!-- Accent Line -->
                        <Border Width="4" HorizontalAlignment="Left" Background="#F57C00" Margin="-16 -16 0 -16" CornerRadius="12 0 0 12"/>
                        <StackPanel Margin="12 0 0 0">
                            <TextBlock Text="SKT YAKLAŞAN (15 GÜN)" Foreground="#F57C00" FontWeight="Bold" FontSize="11" Margin="0 0 0 4"/>
                            <TextBlock x:Name="TxtStatExpiring" Text="{Binding Stats.ExpiringSoon}" Foreground="#F57C00" FontFamily="{DynamicResource FontHeadline}" FontWeight="Bold" FontSize="32"/>
                        </StackPanel>
                        <Border Background="#FFE0B2" CornerRadius="20" Width="40" Height="40" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="⏳" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ALT BÖLÜM: Ürün Listesi -->
            <Border BorderBrush="{DynamicResource ColorOutlineVariant}" BorderThickness="1" CornerRadius="12" Background="{DynamicResource ColorSurfaceContainerLowest}" ClipToBounds="True">
                <Grid Height="500">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Table Actions Header -->
                    <Border Grid.Row="0" Background="{DynamicResource ColorSurface}" BorderBrush="{DynamicResource ColorOutlineVariant}" BorderThickness="0 0 0 1" Padding="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0 0 16 0">
                                <TextBlock Text="📋 " Foreground="{DynamicResource ColorOutlineVariant}" FontSize="18" VerticalAlignment="Center"/>
                                <TextBlock Text="Ürün Listesi" FontFamily="{DynamicResource FontHeadline}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource ColorOnSurface}" VerticalAlignment="Center"/>
                            </StackPanel>
                            
                            <Button Grid.Column="1" Style="{StaticResource SuccessButtonStyle}" Padding="12 6" Margin="0 0 8 0" Click="BtnExcelImport_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📄 " FontSize="14"/>
                                    <TextBlock Text="Excel'den Yükle" FontSize="13"/>
                                </StackPanel>
                            </Button>
                            
                            <Button Grid.Column="2" Style="{StaticResource DangerButtonStyle}" Padding="12 6" Command="{Binding DeleteSelectedCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🗑️ " FontSize="14"/>
                                    <TextBlock Text="Seçilenleri Sil" FontSize="13"/>
                                </StackPanel>
                            </Button>
                            
                            <Grid Grid.Column="4" Width="250">
                                <TextBox x:Name="TxtSearch" Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBoxStyle}" Height="36" Padding="32 0 8 0"/>
                                <TextBlock Text="🔍" FontSize="16" Foreground="{DynamicResource ColorOutlineVariant}" VerticalAlignment="Center" Margin="10 0 0 0" IsHitTestVisible="False" HorizontalAlignment="Left"/>
                                <TextBlock Text="Ürün ara..." Foreground="{DynamicResource ColorOutlineVariant}" FontSize="14" VerticalAlignment="Center" Margin="34 0 0 0" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text.Length, ElementName=TxtSearch}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Grid>
                    </Border>
                    
                    <!-- DataGrid -->
                    <DataGrid x:Name="ProductsGrid" ItemsSource="{Binding Products}" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                              HeadersVisibility="Column" Background="Transparent" RowBackground="Transparent" RowHeight="64"
                              AlternatingRowBackground="{DynamicResource ColorSurface}" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource ColorOutlineVariant}" BorderThickness="0" FontSize="14">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F1F5F9"/>
                                <Setter Property="Foreground" Value="#475569"/>
                                <Setter Property="FontFamily" Value="{DynamicResource FontBody}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Padding" Value="16,12"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource ColorOutlineVariant}"/>
                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                            </Style>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="16,6"/>
                                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                <Setter Property="BorderThickness" Value="0,0,1,0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F8FAFC"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <!-- Checkbox -->
                            <DataGridTemplateColumn Width="50">
                                <DataGridTemplateColumn.Header>
                                    <CheckBox x:Name="ChkSelectAll" Click="ChkSelectAll_Click" HorizontalAlignment="Center"/>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="BARKOD" Binding="{Binding Barcode}" Width="150" Foreground="{DynamicResource ColorOnSurfaceVariant}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="ÜRÜN ADI" Binding="{Binding Name}" Width="*" FontWeight="SemiBold"/>
                            <DataGridTextColumn Header="KATEGORİ" Binding="{Binding Category}" Width="150" Foreground="{DynamicResource ColorOnSurfaceVariant}"/>
                            <DataGridTextColumn Header="ALIŞ (₺)" Binding="{Binding BuyPrice, StringFormat=C2}" Width="100"/>
                            <DataGridTextColumn Header="SATIŞ (₺)" Binding="{Binding Price, StringFormat=C2}" Width="100" FontWeight="SemiBold"/>
                            
                            <!-- Stok (With Alert Trigger) -->
                            <DataGridTemplateColumn Header="STOK" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Padding="6 2" CornerRadius="4" HorizontalAlignment="Left">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCriticalStock}" Value="True">
                                                            <Setter Property="Background" Value="#FFDAD6"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StockQuantity}" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCriticalStock}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource ColorError}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding StockQuantity, UpdateSourceTrigger=PropertyChanged}" Margin="0" Padding="4"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            
                            <!-- SKT (With Alert Trigger) -->
                            <DataGridTemplateColumn Header="SKT" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Padding="6 4" CornerRadius="6" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsExpiringSoon}" Value="True">
                                                            <Setter Property="Background" Value="#FFE0B2"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                                <TextBlock Text="{Binding ExpirationDate, StringFormat=dd.MM.yyyy}" FontWeight="Bold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsExpiringSoon}" Value="True">
                                                                    <Setter Property="Foreground" Value="#F57C00"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding ExpirationStatusText}" FontSize="11" Opacity="0.8">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsExpiringSoon}" Value="True">
                                                                    <Setter Property="Foreground" Value="#F57C00"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <DatePicker SelectedDate="{Binding ExpirationDate, UpdateSourceTrigger=PropertyChanged}" Margin="0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            
                            <DataGridTextColumn Header="KDV (%)" Binding="{Binding KdvRate}" Width="80"/>
                            
                            <DataGridTemplateColumn Header="İŞLEM" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Kaydet" Command="{Binding DataContext.SaveRowProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Background="#3B82F6" Foreground="White" Padding="8 4" BorderThickness="0" FontSize="12">
                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                            </Button>
                                            <Button Content="Sil" Command="{Binding DataContext.DeleteProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Background="{StaticResource ColorError}" Foreground="White" Padding="8 4" BorderThickness="0" FontSize="12" Margin="4 0 0 0">
                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
            
        </StackPanel>
    </ScrollViewer>
</UserControl>
