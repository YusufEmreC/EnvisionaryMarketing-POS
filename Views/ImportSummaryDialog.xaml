<Window x:Class="PosApp.Views.ImportSummaryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Excel İçe Aktarma Özeti" Width="520" SizeToContent="Height" MinHeight="350"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource ColorSurface}" FontFamily="{DynamicResource FontBody}" WindowStyle="ToolWindow">
        
    <Window.Resources>
        <!-- Success Button Style -->
        <Style TargetType="Button" x:Key="SuccessButtonStyle">
            <Setter Property="Background" Value="{DynamicResource ColorSuccess}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="{DynamicResource FontBody}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#059669"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Outline Button Style -->
        <Style TargetType="Button" x:Key="OutlineButtonStyle">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ColorOnSurfaceVariant}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ColorOutlineVariant}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="{DynamicResource FontBody}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ColorBackground}"/>
                                <Setter Property="Foreground" Value="{DynamicResource ColorOnSurface}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Margin="24">
        <!-- Başlık -->
        <StackPanel Margin="0 0 0 16">
            <TextBlock Text="📄 Excel İçe Aktarma Özeti" FontFamily="{DynamicResource FontHeadline}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource ColorOnSurface}"/>
            <TextBlock Text="Dosyadaki ürünler veritabanına kaydedilmeden önce analiz edildi." FontSize="14" Foreground="{DynamicResource ColorOnSurfaceVariant}" Margin="0 4 0 0" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Detay Kartı -->
        <Border Background="{DynamicResource ColorSurfaceContainerLowest}" BorderBrush="{DynamicResource ColorOutlineVariant}" BorderThickness="1" CornerRadius="12" Padding="20">
            <StackPanel>
                <TextBlock x:Name="TxtTotal" Text="Okunan Toplam Ürün: 0" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource ColorOnSurface}" Margin="0 0 0 16"/>
                
                <StackPanel Orientation="Horizontal" Margin="0 0 0 12">
                    <TextBlock Text="✅ " FontSize="16"/>
                    <TextBlock x:Name="TxtNew" Text="0 adet tamamen yeni ürün eklenecek." FontSize="15" Foreground="{DynamicResource ColorSuccess}" FontWeight="Bold" TextWrapping="Wrap"/>
                </StackPanel>
                
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🔄 " FontSize="16"/>
                    <TextBlock x:Name="TxtUpdated" Text="0 adet ürün sistemde mevcut, stokları üzerine eklenecek." FontSize="15" Foreground="#004B73" FontWeight="Bold" TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Uyarı Alanı -->
        <Border x:Name="WarningBox" Background="#FFF8E1" BorderBrush="#FFB300" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0 16 0 0" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="⚠️" FontSize="24" VerticalAlignment="Center" Margin="0 0 12 0"/>
                <TextBlock Grid.Column="1" x:Name="TxtWarning" FontSize="13" Foreground="#B07B00" TextWrapping="Wrap" VerticalAlignment="Center"/>
            </Grid>
        </Border>
        
        <!-- Butonlar -->
        <Grid Margin="0 24 0 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="İptal Et" Style="{StaticResource OutlineButtonStyle}" Height="44" Click="BtnCancel_Click"/>
            <Button Grid.Column="2" Content="Onayla ve Yükle" Style="{StaticResource SuccessButtonStyle}" Height="44" Click="BtnApprove_Click"/>
        </Grid>
    </StackPanel>
</Window>
