<Window x:Class="PosApp.Views.ModernMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mesaj" SizeToContent="Height" Width="450" MinHeight="250" MaxHeight="600"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False">
    
    <Border Background="{DynamicResource ColorSurfaceContainerLowest}" 
            BorderBrush="{DynamicResource ColorOutlineVariant}" 
            BorderThickness="1" 
            CornerRadius="16" 
            Margin="10">
        <Border.Effect>
            <DropShadowEffect Color="#191C1E" BlurRadius="20" ShadowDepth="4" Opacity="0.15"/>
        </Border.Effect>
        
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0 0 0 16">
                <TextBlock x:Name="TxtIcon" Text="ℹ️" FontSize="24" Margin="0 0 12 0" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtTitle" Text="Başlık" FontFamily="{DynamicResource FontHeadline}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource ColorOnSurface}" VerticalAlignment="Center"/>
            </StackPanel>
            
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0 0 0 16" MaxHeight="300">
                <TextBlock x:Name="TxtMessage" Text="Mesaj içeriği buraya gelecek." 
                           FontFamily="{DynamicResource FontBody}" FontSize="14" Foreground="{DynamicResource ColorOnSurfaceVariant}" 
                           TextWrapping="Wrap" VerticalAlignment="Top"/>
            </ScrollViewer>
            
            <StackPanel x:Name="PanelButtons" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 16 0 0">
                <Button x:Name="BtnYes" Content="Evet" Visibility="Collapsed" Margin="0 0 8 0" Click="BtnYes_Click"
                        Background="{DynamicResource ColorPrimary}" Foreground="White" BorderThickness="0" Padding="24 8" FontWeight="Bold">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}" x:Name="Bg">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="#003451"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                
                <Button x:Name="BtnCancel" Content="İptal" Visibility="Collapsed" Margin="0 0 8 0" Click="BtnCancel_Click"
                        Background="Transparent" Foreground="{DynamicResource ColorOnSurfaceVariant}" BorderThickness="0" Padding="16 8" FontWeight="Bold">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}" x:Name="Bg">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ColorSurfaceContainerHigh}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                
                <Button x:Name="BtnOk" Content="Tamam" Visibility="Visible" Click="BtnOk_Click"
                        Background="{DynamicResource ColorPrimary}" Foreground="White" BorderThickness="0" Padding="24 8" FontWeight="Bold">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}" x:Name="Bg">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="#003451"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
