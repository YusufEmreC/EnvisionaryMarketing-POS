<Window x:Class="PosApp.Views.CashCountDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kasa Sayımı" Height="480" Width="420"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize"
        Background="Transparent" AllowsTransparency="True" FontFamily="{DynamicResource FontBody}"
        Topmost="True" ShowInTaskbar="False">
    
    <Border Background="{DynamicResource ColorSurfaceContainerLowest}" 
            BorderBrush="{DynamicResource ColorOutlineVariant}" 
            BorderThickness="1" 
            CornerRadius="16" 
            Margin="10">
        <Border.Effect>
            <DropShadowEffect Color="#191C1E" BlurRadius="20" ShadowDepth="4" Opacity="0.15"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="{DynamicResource ColorPrimary}" CornerRadius="15 15 0 0" Padding="16">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="🔒 " FontSize="20" Foreground="{DynamicResource ColorOnPrimary}" VerticalAlignment="Center"/>
                    <TextBlock Text="GÜN SONU KAPANIŞ (Z-RAPORU)" FontFamily="{DynamicResource FontHeadline}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource ColorOnPrimary}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- İçerik -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly" Margin="0 10 0 10">
                <StackPanel Margin="24 10 24 10">
                    <TextBlock Text="Z-Raporu almadan önce güncel kasa verilerinizi girin." FontSize="14" Foreground="{DynamicResource ColorOnSurfaceVariant}" TextWrapping="Wrap" TextAlignment="Center" Margin="0 0 0 24"/>

                    <TextBlock Text="Kasa Açılış Nakdi (₺)" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource ColorOnSurface}" Margin="0 0 0 8"/>
                    <TextBox x:Name="TxtOpeningCash" FontSize="20" FontWeight="SemiBold" Padding="12 8" Margin="0 0 0 16" TextAlignment="Right" Background="{DynamicResource ColorSurfaceContainerHigh}" BorderBrush="{DynamicResource ColorOutlineVariant}" BorderThickness="1" GotFocus="TextBox_GotFocus" LostFocus="TextBox_LostFocus">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>

                    <TextBlock Text="Günlük Toplam Masraf / Gider (₺)" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource ColorOnSurface}" Margin="0 0 0 8"/>
                    <TextBox x:Name="TxtExpenses" FontSize="20" FontWeight="SemiBold" Padding="12 8" Margin="0 0 0 16" TextAlignment="Right" Background="{DynamicResource ColorSurfaceContainerHigh}" BorderBrush="{DynamicResource ColorOutlineVariant}" BorderThickness="1" GotFocus="TextBox_GotFocus" LostFocus="TextBox_LostFocus">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>

                    <TextBlock Text="Kasada Sayılan Net Nakit (₺)" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource ColorOnSurface}" Margin="0 0 0 8"/>
                    <TextBox x:Name="TxtCountedCash" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource ColorSuccess}" Padding="12 8" TextAlignment="Right" Background="{DynamicResource ColorSurfaceContainerHigh}" BorderBrush="{DynamicResource ColorOutlineVariant}" BorderThickness="1" GotFocus="TextBox_GotFocus" LostFocus="TextBox_LostFocus">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>
                </StackPanel>
            </ScrollViewer>

            <!-- Butonlar -->
            <Border Grid.Row="2" Background="{DynamicResource ColorSurfaceContainerLow}" CornerRadius="0 0 15 15" Padding="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <Button Grid.Column="0" Content="İptal" Background="Transparent" Foreground="{DynamicResource ColorOnSurfaceVariant}" FontSize="16" FontWeight="Bold" Padding="12 12" BorderThickness="0" Click="BtnCancel_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}" x:Name="Bg">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ColorSurfaceContainerHigh}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Grid.Column="2" Content="ONAYLA" Background="{DynamicResource ColorPrimary}" Foreground="{DynamicResource ColorOnPrimary}" FontSize="16" FontWeight="Bold" Padding="12 12" BorderThickness="0" Click="BtnConfirm_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}" x:Name="Bg">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="#003451"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
