<Window x:Class="PosApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ENVISIONARY Marketing" Height="800" Width="1280" WindowState="Maximized"
        WindowStartupLocation="CenterScreen" 
        Background="{DynamicResource ColorBackground}" FontFamily="{DynamicResource FontBody}"
        Icon="pack://application:,,,/Assets/app.ico">
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/> <!-- sidebar-width -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar (Navigasyon Menüsü) -->
        <Border Grid.Column="0" Background="{DynamicResource ColorSurface}" BorderBrush="{DynamicResource ColorBorder}" BorderThickness="0 0 1 0">
            <Grid Margin="0 24 0 24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header / Logo -->
                <StackPanel Grid.Row="0" Margin="24 0 24 32">
                    <StackPanel Orientation="Horizontal" Margin="0 0 0 24">
                        <Image Source="pack://application:,,,/Assets/app_logo.png" Width="48" Height="48" Stretch="Uniform"/>
                        <StackPanel Margin="12 0 0 0" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtCompanyName" Text="ENVISIONARY Marketing" FontFamily="{DynamicResource FontHeadline}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource ColorTextPrimary}"/>
                            <TextBlock Text="Station 01" FontSize="13" Foreground="{DynamicResource ColorTextSecondary}"/>
                        </StackPanel>
                    </StackPanel>
                    
                    <!-- Aktif Oturum Kartı -->
                    <Border Background="{DynamicResource ColorBackground}" BorderBrush="{DynamicResource ColorBorder}" BorderThickness="1" CornerRadius="{DynamicResource RadiusMd}" Padding="12 8" Margin="0 0 0 12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#E8F0FE" Width="36" Height="36" CornerRadius="18" Margin="0 0 12 0">
                                <TextBlock Text="👤" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Aktif Oturum" FontSize="11" Foreground="{DynamicResource ColorTextSecondary}" FontWeight="SemiBold" Margin="0 0 0 2"/>
                                <TextBlock x:Name="TxtCurrentUser" Text="Süheyl Yönetici" FontFamily="{DynamicResource FontHeadline}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource ColorTextPrimary}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Saat ve Tarih Kartı -->
                    <Border Background="{DynamicResource ColorSurface}" BorderBrush="{DynamicResource ColorBorder}" BorderThickness="1" CornerRadius="{DynamicResource RadiusMd}" Padding="12" Margin="0 0 0 10">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 0 0 4">
                                <TextBlock Text="🕒" FontSize="18" VerticalAlignment="Center" Margin="0 0 8 0" Foreground="{DynamicResource ColorPrimary}"/>
                                <TextBlock x:Name="TxtClockTime" Text="00:00" FontFamily="{DynamicResource FontHeadline}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource ColorTextPrimary}"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtClockDate" Text="01.01.2023" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ColorTextSecondary}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                
                <!-- Navigasyon -->
                <StackPanel Grid.Row="1" Margin="16 0 16 0">
                    <Button x:Name="BtnNavReports" Style="{DynamicResource SidebarInactiveButtonStyle}" Padding="16 12" Margin="0 4" Click="NavReports_Click">
                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left">
                            <TextBlock Text="📊 Performans &amp; Analiz"/>
                        </Viewbox>
                    </Button>
                    <Button x:Name="BtnNavCheckout" Content="🛒 Kasa (Satış)" Style="{DynamicResource SidebarActiveButtonStyle}" Padding="16 12" Margin="0 4" Click="NavCheckout_Click"/>
                    <Button x:Name="BtnNavInventory" Content="📦 Envanter &amp; Stok" Style="{DynamicResource SidebarInactiveButtonStyle}" Padding="16 12" Margin="0 4" Click="NavInventory_Click"/>
                    <Button x:Name="BtnNavArchive" Content="📁 Z-Raporu Arşivi" Style="{DynamicResource SidebarInactiveButtonStyle}" Padding="16 12" Margin="0 4" Click="NavArchive_Click"/>
                    <Button x:Name="BtnNavClosing" Content="🔒 Kapanış (Z-Rapor)" Style="{DynamicResource SidebarInactiveButtonStyle}" Padding="16 12" Margin="0 4" Click="NavClosing_Click"/>
                    <Button x:Name="BtnNavUsers" Content="👥 Kullanıcılar" Style="{DynamicResource SidebarInactiveButtonStyle}" Padding="16 12" Margin="0 4" Click="NavUsers_Click"/>
                    <Button x:Name="BtnNavSettings" Content="⚙️ Ayarlar" Style="{DynamicResource SidebarInactiveButtonStyle}" Margin="0 4" Click="NavSettings_Click"/>
                    
                    <Border BorderBrush="{DynamicResource ColorBorder}" BorderThickness="0 1 0 0" Margin="0 12 0 12"/>
                    <Button x:Name="BtnLogout" Content="🚪 Çıkış Yap" Style="{DynamicResource SidebarInactiveButtonStyle}" Foreground="#EF4444" Padding="16 12" Margin="0 4" Click="BtnLogout_Click"/>
                </StackPanel>

                <!-- Alt Kısım -->
                <StackPanel Grid.Row="2" Margin="16 0 16 24">
                    <Border BorderBrush="{DynamicResource ColorBorder}" BorderThickness="0 1 0 0" Padding="16 16 16 0">
                        <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Center">
                            <!-- Sabit Firma Adı -->
                            <TextBlock Text="SUHEYL GROUP" FontFamily="{DynamicResource FontHeadline}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource ColorTextPrimary}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="0 0 0 8"/>
                            
                            <!-- Geliştirici Bilgisi -->
                            <TextBlock Text="Developed by Envisionary Systems" FontFamily="{DynamicResource FontBody}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ColorTextSecondary}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="0 0 0 4"/>
                            <TextBlock Text="All Rights Reserved" FontSize="11" FontFamily="{DynamicResource FontBody}" Foreground="{DynamicResource ColorTextSecondary}" HorizontalAlignment="Center" Margin="0 0 0 2"/>
                            <TextBlock Text="Version 1.0" FontSize="11" FontFamily="{DynamicResource FontBody}" FontWeight="SemiBold" Foreground="{DynamicResource ColorTextSecondary}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Orta İçerik Ekranı -->
        <ContentControl x:Name="MainContent" Grid.Column="1" />
    </Grid>
</Window>
