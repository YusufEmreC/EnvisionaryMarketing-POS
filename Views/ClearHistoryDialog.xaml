<Window x:Class="PosApp.Views.ClearHistoryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Geçmişi Sil"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{DynamicResource FontBody}">
    
    <Border Background="{DynamicResource ColorSurface}" CornerRadius="{DynamicResource RadiusXl}" Margin="32" Padding="32" BorderBrush="{DynamicResource ColorBorder}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.15" BlurRadius="30" ShadowDepth="10"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0 0 0 24">
                <TextBlock x:Name="TxtTitle" Text="🗑️ Geçmiş Verileri Sil" FontFamily="{DynamicResource FontHeadline}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource ColorError}"/>
                <TextBlock Text="Hangi verilerin kalıcı olarak silineceğini seçin:" Foreground="{DynamicResource ColorOnSurfaceVariant}" FontSize="14" Margin="0 4 0 0" TextWrapping="Wrap" Width="350"/>
            </StackPanel>

            <!-- Options -->
            <StackPanel Grid.Row="1" Margin="0 0 0 32">
                <RadioButton x:Name="RbKeepOneMonth" Content="30 Günden Eski Verileri Sil (Son 1 Ayı Koru)" FontSize="16" Margin="0 0 0 16" IsChecked="True"/>
                <RadioButton x:Name="RbDeleteAll" Content="Tüm Geçmişi Sil (Sıfırla)" FontSize="16" Foreground="{DynamicResource ColorError}"/>
            </StackPanel>

            <!-- Actions -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="İptal" Style="{DynamicResource OutlineButtonStyle}" Height="48" FontSize="16" Margin="0 0 8 0" Click="BtnCancel_Click"/>
                <Button Grid.Column="1" Content="Silmeyi Onayla" Style="{DynamicResource PrimaryButtonStyle}" Background="{DynamicResource ColorError}" Height="48" FontSize="16" FontWeight="Bold" Margin="8 0 0 0" Click="BtnConfirm_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
