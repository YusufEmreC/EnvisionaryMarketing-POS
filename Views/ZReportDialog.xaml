<Window x:Class="PosApp.Views.ZReportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Z-Raporu Kasa Kapanış" Height="420" Width="350" 
        WindowStartupLocation="CenterOwner" Background="#F4F6F9" ResizeMode="NoResize" FontFamily="Segoe UI"
        Icon="pack://application:,,,/Assets/app.ico">
    <StackPanel Margin="20">
        <TextBlock Text="Kapanış Detayları" FontSize="22" FontWeight="Bold" Foreground="#2C3E50" Margin="0 0 0 20" HorizontalAlignment="Center"/>
        
        <TextBlock Text="Kasadaki Nakit (₺)" FontWeight="SemiBold" Margin="0 0 0 5"/>
        <TextBox x:Name="TxtOpeningCash" Margin="0 0 0 15" Padding="5" FontSize="16"/>

        <TextBlock Text="Gün İçi İadeler (₺)" FontWeight="SemiBold" Margin="0 0 0 5"/>
        <TextBox x:Name="TxtRefunds" Margin="0 0 0 15" Padding="5" FontSize="16" Text="0"/>

        <TextBlock Text="Gün İçi Masraflar (Giderler - ₺)" FontWeight="SemiBold" Margin="0 0 0 5"/>
        <TextBox x:Name="TxtExpenses" Margin="0 0 0 25" Padding="5" FontSize="16" Text="0"/>

        <Button Content="Onayla ve Kapat" Background="#E74C3C" Foreground="White" Padding="12" FontWeight="Bold" FontSize="18" Click="BtnConfirm_Click" BorderThickness="0">
            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
        </Button>
    </StackPanel>
</Window>
