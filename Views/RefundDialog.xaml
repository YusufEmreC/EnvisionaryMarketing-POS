<Window x:Class="PosApp.Views.RefundDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="İade İşlemi" 
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{DynamicResource FontBody}">
    
    <Border Background="{DynamicResource ColorSurface}" 
            CornerRadius="{DynamicResource RadiusXl}" 
            Width="480" Margin="32" Padding="32"
            BorderBrush="{DynamicResource ColorBorder}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.15" BlurRadius="30" ShadowDepth="10"/>
        </Border.Effect>
        
        <StackPanel>
            <!-- Header -->
            <Grid Margin="0 0 0 32">
                <TextBlock Text="İade İşlemi" FontFamily="{DynamicResource FontHeadline}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource ColorTextPrimary}"/>
                <Button HorizontalAlignment="Right" VerticalAlignment="Center" Width="36" Height="36" Background="Transparent" BorderThickness="0" Click="BtnCancel_Click" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="CloseBdr" Background="{DynamicResource ColorBackground}" CornerRadius="{DynamicResource RadiusMd}">
                                <TextBlock Text="✕" Foreground="{DynamicResource ColorTextSecondary}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="CloseBdr" Property="Background" Value="#FEE2E2"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- Product Search -->
            <TextBlock Text="BARKOD VEYA ÜRÜN KODU" Foreground="{DynamicResource ColorTextSecondary}" FontSize="13" FontWeight="SemiBold" Margin="0 0 0 8"/>
            <Grid Margin="0 0 0 24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="110"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtRefundBarcode" Grid.Column="0" Style="{DynamicResource ModernTextBoxStyle}" Height="48" FontSize="16" KeyDown="TxtRefundBarcode_KeyDown" TextChanged="TxtRefundBarcode_TextChanged" Padding="16 0"/>
                <Button Grid.Column="1" Content="Ürünü Bul" Style="{DynamicResource PrimaryButtonStyle}" Height="48" Margin="12 0 0 0" Click="BtnFindProduct_Click"/>
            </Grid>

            <!-- Arama Önerileri Popup -->
            <Popup x:Name="SuggestionsPopup" PlacementTarget="{Binding ElementName=TxtRefundBarcode}" Placement="Bottom" StaysOpen="False" Width="{Binding ElementName=TxtRefundBarcode, Path=ActualWidth}">
                <Border Background="{DynamicResource ColorSurface}" BorderBrush="{DynamicResource ColorBorder}" BorderThickness="1" CornerRadius="0 0 8 8">
                    <ListBox x:Name="LbxSuggestions" MaxHeight="150" Background="Transparent" BorderThickness="0" SelectionChanged="LbxSuggestions_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="Bold" FontSize="14"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Price, StringFormat={}{0:C2}}" Foreground="{DynamicResource ColorPrimary}" FontWeight="Bold" FontSize="14" Margin="10 0 0 0"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Popup>

            <!-- Quantity & Info -->
            <TextBlock x:Name="LblQuantityTitle" Text="İADE ADEDİ" Foreground="{DynamicResource ColorTextSecondary}" FontSize="13" FontWeight="SemiBold" Margin="0 0 0 8"/>
            <TextBox x:Name="TxtRefundQuantity" Text="1" Style="{DynamicResource ModernTextBoxStyle}" Height="48" FontSize="20" FontWeight="Bold" TextChanged="TxtRefundQuantity_TextChanged" Margin="0 0 0 24" TextAlignment="Center"/>
            
            <!-- Result Panel -->
            <Border Background="{DynamicResource ColorBackground}" CornerRadius="{DynamicResource RadiusMd}" Padding="16" Margin="0 0 0 32" MinHeight="64">
                <TextBlock x:Name="TxtProductInfo" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource ColorTextSecondary}" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Text="Barkod okutarak veya ürün kodunu yazarak iade edilecek ürünü bulun."/>
            </Border>

            <!-- Action Buttons -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="BtnConfirmNakit" Grid.Column="0" Content="Nakit İade" Style="{DynamicResource SuccessButtonStyle}" Height="56" FontSize="16" FontWeight="Bold" Margin="0 0 8 0" IsEnabled="False" Click="BtnConfirmNakit_Click"/>
                <Button x:Name="BtnConfirmKart" Grid.Column="1" Content="Kartla İade" Style="{DynamicResource PrimaryButtonStyle}" Height="56" FontSize="16" FontWeight="Bold" Margin="8 0 0 0" IsEnabled="False" Click="BtnConfirmKart_Click"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
