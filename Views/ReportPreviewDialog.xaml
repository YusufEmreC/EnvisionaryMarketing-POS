<Window x:Class="PosApp.Views.ReportPreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rapor Önizleme" Height="680" Width="480"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize"
        Background="Transparent" AllowsTransparency="True" FontFamily="{DynamicResource FontBody}"
        Topmost="True" ShowInTaskbar="False" MouseLeftButtonDown="Window_MouseLeftButtonDown">
    
    <Border Background="{DynamicResource ColorSurfaceContainerLowest}" 
            BorderBrush="{DynamicResource ColorOutlineVariant}" 
            BorderThickness="1" 
            CornerRadius="16" 
            Margin="15">
        <Border.Effect>
            <DropShadowEffect Color="#191C1E" BlurRadius="20" ShadowDepth="4" Opacity="0.15"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="{DynamicResource ColorPrimary}" CornerRadius="15 15 0 0" Padding="16">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="📄 " FontSize="20" Foreground="{DynamicResource ColorOnPrimary}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtTitle" Text="Rapor Önizleme" FontFamily="{DynamicResource FontHeadline}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource ColorOnPrimary}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Content="✕" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource ColorOnPrimary}" Background="Transparent" BorderThickness="0" HorizontalAlignment="Right" VerticalAlignment="Center" Click="BtnClose_Click" Cursor="Hand" Padding="10 0"/>
                </Grid>
            </Border>

            <!-- İçerik (Fiş) -->
            <Border Grid.Row="1" Background="{DynamicResource ColorSurfaceContainerLowest}" BorderBrush="{DynamicResource ColorOutlineVariant}" BorderThickness="1" Margin="24 24 24 16" CornerRadius="8">
                <!-- PanningMode eklendi, böylece dokunmatik ekranlarda kaydırma yapılabilir -->
                <ScrollViewer VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly" Margin="10">
                    <TextBlock x:Name="TxtReportContent" 
                               Text="Rapor İçeriği..." 
                               FontFamily="Consolas" 
                               FontSize="16" 
                               FontWeight="Bold"
                               Foreground="{DynamicResource ColorOnSurface}" 
                               TextWrapping="Wrap"
                               LineHeight="24"
                               Padding="8"/>
                </ScrollViewer>
            </Border>

            <!-- Butonlar -->
            <Border Grid.Row="2" Background="{DynamicResource ColorSurfaceContainerLow}" CornerRadius="0 0 15 15" Padding="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <Button Grid.Column="0" Content="Kapat" Background="Transparent" Foreground="{DynamicResource ColorOnSurfaceVariant}" FontSize="16" FontWeight="Bold" Padding="12 12" BorderThickness="0" Click="BtnClose_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}" x:Name="Bg">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ColorSurfaceContainerHigh}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Grid.Column="2" Content="🖨️ YAZDIR" Background="{DynamicResource ColorSuccess}" Foreground="White" FontSize="16" FontWeight="Bold" Padding="12 12" BorderThickness="0" Click="BtnPrint_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}" x:Name="Bg">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="#059669"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
