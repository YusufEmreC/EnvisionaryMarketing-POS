<UserControl x:Class="PosApp.Views.CheckoutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource ColorBackground}" FontFamily="{DynamicResource FontBody}">
    <UserControl.Resources>
        <Style TargetType="RadioButton" x:Key="CategoryToggleStyle">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Border" Background="{DynamicResource ColorSurface}" BorderBrush="{DynamicResource ColorBorder}" BorderThickness="1" CornerRadius="24" Padding="20 12" Margin="0 0 8 0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextBlock.Foreground="{DynamicResource ColorTextSecondary}" TextBlock.FontWeight="SemiBold" TextBlock.FontSize="14"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource ColorPrimary}"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource ColorPrimary}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource ColorBackground}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource ColorPrimaryHover}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <!-- Fallback foreground trigger -->
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    
    <!-- Ana İçerik Container (3:1 Split-Pane Layout) -->
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        
        <!-- LEFT PANE: Product & Category Grid -->
        <Grid Grid.Column="0" Margin="0 0 24 0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- Top Bar: Search Input -->
            <StackPanel Grid.Row="0" Margin="0 0 0 16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Large Touch-friendly Search Input (Min 48px) -->
                    <Grid Grid.Column="0">
                        <TextBox x:Name="TxtManualBarcode" Text="{Binding ManualBarcode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBoxStyle}" FontSize="16" Height="48" KeyDown="TxtManualBarcode_KeyDown" Padding="48 0 16 0"/>
                        <!-- Barcode Icon -->
                        <TextBlock Text="🔍" FontSize="20" Foreground="{DynamicResource ColorTextSecondary}" VerticalAlignment="Center" Margin="16 0 0 0" IsHitTestVisible="False" HorizontalAlignment="Left"/>
                        <!-- Placeholder -->
                        <TextBlock Text="Barkod okutun veya ürün adı yazın..." Foreground="{DynamicResource ColorTextSecondary}" FontSize="16" VerticalAlignment="Center" Margin="48 0 0 0" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text.Length, ElementName=TxtManualBarcode}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    
                    <Button Grid.Column="1" Content="Ekle" Style="{DynamicResource PrimaryButtonStyle}" FontSize="16" Width="100" Height="48" Margin="12 0 0 0" Command="{Binding ProcessBarcodeCommand}"/>
                </Grid>
                
                <Popup x:Name="SuggestionsPopup" IsOpen="{Binding IsSuggestionsOpen}" PlacementTarget="{Binding ElementName=TxtManualBarcode}" StaysOpen="False" Width="{Binding ElementName=TxtManualBarcode, Path=ActualWidth}">
                    <Border Background="{DynamicResource ColorSurface}" BorderBrush="{DynamicResource ColorBorder}" BorderThickness="1" CornerRadius="{DynamicResource RadiusMd}">
                        <ListBox x:Name="LbxSuggestions" ItemsSource="{Binding SearchSuggestions}" SelectedItem="{Binding SelectedSuggestion, Mode=TwoWay}" MaxHeight="200" DisplayMemberPath="Name" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource ColorTextPrimary}" FontSize="16">
                        </ListBox>
                    </Border>
                </Popup>
            </StackPanel>

            <!-- Category Strip Removed -->
            
            <!-- Grid of Product Tiles -->
            <Border Grid.Row="1" Background="{DynamicResource ColorSurface}" BorderBrush="{DynamicResource ColorBorder}" BorderThickness="1" CornerRadius="{DynamicResource RadiusXl}" Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <!-- Products are bound here from QuickProducts -->
                    <ItemsControl x:Name="IcQuickProductsModal" ItemsSource="{Binding QuickProducts}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4" VerticalAlignment="Top"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Margin="8" Height="140" Command="{Binding DataContext.AddQuickProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Cursor="Hand" Background="Transparent" BorderThickness="0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <!-- Product Card with 12px Border Radius (RadiusLg) -->
                                            <Border x:Name="CardBorder" Background="{DynamicResource ColorBackground}" BorderBrush="{DynamicResource ColorBorder}" BorderThickness="1" CornerRadius="{DynamicResource RadiusLg}" Padding="16">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    
                                                    <!-- Universal Icon -->
                                                    <Border Grid.Row="0" Background="{DynamicResource ColorBackground}" Height="40" Width="40" CornerRadius="20" HorizontalAlignment="Left" Margin="0 0 0 12">
                                                        <TextBlock Text="📦" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    
                                                    <!-- Name (16px) -->
                                                    <TextBlock Text="{Binding Name}" Grid.Row="1" FontSize="16" FontFamily="{DynamicResource FontBody}" FontWeight="SemiBold" Foreground="{DynamicResource ColorTextPrimary}" TextWrapping="Wrap" VerticalAlignment="Top"/>
                                                    
                                                    <!-- Price (14px bold) -->
                                                    <TextBlock Text="{Binding Price, StringFormat='₺{0:0.00}'}" Grid.Row="2" FontSize="14" FontFamily="{DynamicResource FontBody}" FontWeight="Bold" Foreground="{DynamicResource ColorPrimary}"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="CardBorder" Property="Background" Value="#F2EDE4"/>
                                                    <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource ColorPrimary}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>
        
        <!-- RIGHT PANE: Active Order & Cart -->
        <Border Grid.Column="1" Background="{DynamicResource ColorSurface}" BorderBrush="{DynamicResource ColorBorder}" BorderThickness="1" CornerRadius="{DynamicResource RadiusXl}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <!-- Başlık -->
                <Border Grid.Row="0" BorderBrush="{DynamicResource ColorBorder}" BorderThickness="0 0 0 1" Padding="24">
                    <Grid>
                        <TextBlock Text="Aktif Sipariş" FontFamily="{DynamicResource FontHeadline}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource ColorTextPrimary}" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="İade İşlemi" Style="{DynamicResource OutlineButtonStyle}" Foreground="{DynamicResource ColorError}" BorderBrush="{DynamicResource ColorError}" MinHeight="36" Padding="12 0" Margin="0 0 12 0" Command="{Binding RefundCommand}"/>
                            <Button Content="Temizle" Style="{DynamicResource OutlineButtonStyle}" Foreground="{DynamicResource ColorError}" BorderBrush="{DynamicResource ColorError}" MinHeight="36" Padding="12 0" Command="{Binding ClearCartCommand}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Sepet Listesi (Cart) -->
                <DataGrid x:Name="CartGrid" ItemsSource="{Binding Cart}" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="None" Background="Transparent" RowBackground="Transparent"
                          AlternatingRowBackground="{DynamicResource ColorBackground}" GridLinesVisibility="None" BorderThickness="0" Margin="0">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="16,8"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource ColorBorder}"/>
                            <Setter Property="Foreground" Value="{DynamicResource ColorTextPrimary}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Padding="{TemplateBinding Padding}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <!-- Item Info -->
                        <DataGridTemplateColumn Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Product.Name}" FontSize="16" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Product.Price, StringFormat='₺{0:0.00}'}" FontSize="14" Foreground="{DynamicResource ColorTextSecondary}" Margin="0 4 0 0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        
                        <!-- Quantity Controls -->
                        <DataGridTemplateColumn Width="160">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button Width="40" Height="40" Background="{DynamicResource ColorPrimary}" Foreground="#FFFFFF" Command="{Binding DataContext.DecreaseQtyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Margin="0 0 8 0">
                                            <Grid Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Rectangle Width="14" Height="2" Fill="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource RadiusMd}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        
                                        <TextBlock Text="{Binding Quantity}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Width="24" TextAlignment="Center"/>
                                        
                                        <Button Width="40" Height="40" Background="{DynamicResource ColorPrimary}" Foreground="#FFFFFF" Command="{Binding DataContext.IncreaseQtyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Margin="8 0 0 0">
                                            <Grid Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Rectangle Width="14" Height="2" Fill="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Rectangle Width="2" Height="14" Fill="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource RadiusMd}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Billing Calculations -->
                <Border Grid.Row="2" Background="{DynamicResource ColorBackground}" BorderBrush="{DynamicResource ColorBorder}" BorderThickness="0 1 0 0" Padding="24">
                    <StackPanel>
                        <!-- Discount Input Row -->
                        <Grid Margin="0 0 0 16">
                            <TextBlock Text="İndirim Oranı (%)" Foreground="{DynamicResource ColorTextSecondary}" FontSize="14" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtDiscountPercent" Text="{Binding DiscountPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBoxStyle}" Width="80" Height="36" MinHeight="36" Padding="12 0" HorizontalAlignment="Right" TextAlignment="Right"/>
                        </Grid>
                        
                        <Grid Margin="0 0 0 12">
                            <TextBlock Text="KDV Hariç Tutar" Foreground="{DynamicResource ColorTextSecondary}" FontSize="14"/>
                            <TextBlock x:Name="TxtSubTotal" Text="{Binding SubTotal}" Foreground="{DynamicResource ColorTextSecondary}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                        </Grid>
                        
                        <Grid Margin="0 0 0 12">
                            <TextBlock Text="Toplam KDV (%8 vb.)" Foreground="{DynamicResource ColorTextSecondary}" FontSize="14"/>
                            <TextBlock x:Name="TxtKdv" Text="{Binding KdvTotal}" Foreground="{DynamicResource ColorTextSecondary}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                        </Grid>
                        
                        <Grid Margin="0 0 0 16">
                            <TextBlock Text="İndirim" Foreground="{DynamicResource ColorError}" FontSize="14"/>
                            <TextBlock x:Name="TxtDiscount" Text="{Binding DiscountTotal}" Foreground="{DynamicResource ColorError}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                        </Grid>
                        
                        <Border BorderBrush="{DynamicResource ColorBorder}" BorderThickness="0 1 0 0" Margin="0 0 0 16"/>
                        
                        <!-- TOTAL -->
                        <Grid>
                            <TextBlock Text="TOPLAM" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource ColorTextPrimary}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtTotal" Text="{Binding FinalTotal}" FontFamily="{DynamicResource FontHeadline}" FontWeight="Black" FontSize="32" Foreground="{DynamicResource ColorTextPrimary}" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>
                
                <!-- PAY NOW Button -->
                <Border Grid.Row="3" Padding="24" Background="{DynamicResource ColorSurface}" CornerRadius="0 0 16 16">
                    <Button Content="ÖDEME AL (PAY NOW)" Style="{DynamicResource SuccessButtonStyle}" Command="{Binding PayCommand}"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
