<UserControl x:Class="PosApp.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource ColorSurfaceContainerLowest}" FontFamily="{DynamicResource FontBody}">

    <UserControl.Resources>
        <!-- Settings Section Style -->
        <Style TargetType="Border" x:Key="SettingsSectionStyle">
            <Setter Property="Background" Value="{StaticResource ColorSurfaceContainerLowest}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ColorOutlineVariant}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Margin" Value="0,0,0,24"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#E1E5EB" BlurRadius="6" ShadowDepth="1" Opacity="0.5"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Save Button Style -->
        <Style TargetType="Button" x:Key="SaveButtonStyle">
            <Setter Property="Background" Value="#10B981"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="{StaticResource FontBody}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}" x:Name="Bg">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#059669"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid MaxWidth="900" HorizontalAlignment="Left" Margin="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Başlık -->
            <StackPanel Grid.Row="0" Margin="0 0 0 32">
                <TextBlock Text="Sistem Ayarları" FontFamily="{DynamicResource FontHeadline}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource ColorPrimary}" Margin="0 0 0 8"/>
                <TextBlock Text="Yapılandırma ve cihaz tercihlerini yönetin." Foreground="{DynamicResource ColorOnSurfaceVariant}" FontSize="16"/>
            </StackPanel>

            <!-- YAZICI AYARLARI -->
            <Border Grid.Row="1" Style="{StaticResource SettingsSectionStyle}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0 0 0 16">
                        <Border Background="{DynamicResource ColorPrimaryFixed}" CornerRadius="16" Width="32" Height="32" Margin="0 0 12 0">
                            <TextBlock Text="🖨️" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Termal Yazıcı (Fiş ve Rapor Çıktısı)" FontFamily="{DynamicResource FontBody}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource ColorOnSurface}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Margin="44 0 0 0">
                        <ComboBox x:Name="CmbPrinters" ItemsSource="{Binding Printers}" SelectedItem="{Binding SelectedPrinter, Mode=TwoWay}" Height="44" Padding="12 0" FontSize="16" BorderBrush="{DynamicResource ColorOutlineVariant}" Background="{DynamicResource ColorSurfaceBright}" Margin="0 0 0 8" IsEditable="True" Text="{Binding SelectedPrinter, Mode=TwoWay}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- VERİ TEMİZLEME AYARI -->
            <Border Grid.Row="2" Style="{StaticResource SettingsSectionStyle}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0 0 0 16">
                        <Border Background="#FEE2E2" CornerRadius="16" Width="32" Height="32" Margin="0 0 12 0">
                            <TextBlock Text="🗑️" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Veri Yönetimi ve Temizlik" FontFamily="{DynamicResource FontBody}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource ColorOnSurface}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Margin="44 0 0 0">
                        <TextBlock Text="Geçmiş satış fişleri, raporlar ve analiz verilerini silerek sisteminizi hızlandırın." Foreground="{DynamicResource ColorOnSurfaceVariant}" FontSize="14" TextWrapping="Wrap" Margin="0 0 0 12"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ComboBox x:Name="CmbDataCleanupPeriod" SelectedValue="{Binding SelectedCleanupMonths, Mode=TwoWay}" SelectedValuePath="Tag" Grid.Column="0" Width="250" Height="44" Padding="12 0" FontSize="16" BorderBrush="{DynamicResource ColorOutlineVariant}" Background="{DynamicResource ColorSurfaceBright}" Margin="0 0 16 0">
                                <ComboBox.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </ComboBox.Resources>
                                <ComboBoxItem Content="1 Aydan Eski Verileri Sil" Tag="1"/>
                                <ComboBoxItem Content="3 Aydan Eski Verileri Sil" Tag="3"/>
                                <ComboBoxItem Content="6 Aydan Eski Verileri Sil" Tag="6"/>
                                <ComboBoxItem Content="1 Yıldan Eski Verileri Sil" Tag="12"/>
                                <ComboBoxItem Content="Tüm Geçmiş Verileri Sil" Tag="999"/>
                            </ComboBox>

                            <Button Grid.Column="1" Height="44" Padding="16 0" Background="#DC2626" Foreground="White" BorderThickness="0" Command="{Binding ClearDataCommand}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}" x:Name="Bg">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Sil " FontWeight="Bold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bg" Property="Background" Value="#B91C1C"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>


            <!-- YEDEKLEME VE KURTARMA (Row 3) -->
            <Border Grid.Row="3" Style="{StaticResource SettingsSectionStyle}">
                <StackPanel>
                    <!-- YEDEKLEME Başlığı -->
                    <StackPanel Orientation="Horizontal" Margin="0 0 0 16">
                        <TextBlock Text="💾 " FontSize="20" VerticalAlignment="Center" Margin="0 0 8 0"/>
                        <TextBlock Text="Veritabanı Yedekleme ve Kurtarma" FontFamily="{DynamicResource FontBody}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource ColorPrimary}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Margin="44 0 0 0">
                        <TextBlock Text="Flash bellek veya diske verilerinizi manuel olarak yedekleyebilir veya kriz anında yedekten geri yükleyebilirsiniz." Foreground="{DynamicResource ColorOnSurfaceVariant}" FontSize="14" TextWrapping="Wrap" Margin="0 0 0 16"/>
                        
                        <StackPanel Orientation="Horizontal">
                            <Button Height="44" Padding="16 0" Background="{DynamicResource ColorPrimary}" Foreground="White" BorderThickness="0" HorizontalAlignment="Left" Click="BtnBackup_Click" Margin="0 0 16 0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}" x:Name="Bg">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="⬇️ " FontSize="16" VerticalAlignment="Center"/>
                                                <TextBlock Text="Flash'a Yedek Çıkart" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bg" Property="Background" Value="#1E40AF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            
                            <Button Height="44" Padding="16 0" Background="#F59E0B" Foreground="White" BorderThickness="0" HorizontalAlignment="Left" Click="BtnRestore_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}" x:Name="Bg">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="⬆️ " FontSize="16" VerticalAlignment="Center"/>
                                                <TextBlock Text="Flash'tan Yedeği Yükle (Kurtar)" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bg" Property="Background" Value="#D97706"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                        
                        <!-- Auto Backup Info -->
                        <Border Background="#F8FAFC" CornerRadius="8" Padding="12" Margin="0 24 0 0" BorderBrush="{DynamicResource ColorOutlineVariant}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Otomatik Arka Plan Yedeklemeleri:" FontWeight="SemiBold" Foreground="{DynamicResource ColorOnSurface}" FontSize="13" Margin="0 0 0 8"/>
                                
                                <Grid Margin="0 0 0 4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Son Otomatik Yedek:" Foreground="{DynamicResource ColorOnSurfaceVariant}" FontSize="13"/>
                                    <TextBlock x:Name="TxtLastAutoBackup" Grid.Column="1" Text="{Binding LastAutoBackupInfo}" FontWeight="SemiBold" Foreground="{DynamicResource ColorPrimary}" FontSize="13"/>
                                </Grid>
                                
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Otomatik Yedek Konumu:" Foreground="{DynamicResource ColorOnSurfaceVariant}" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtAutoBackupPath" Grid.Column="1" Text="{Binding AutoBackupPath}" Foreground="#2563EB" FontSize="13" TextWrapping="Wrap" Cursor="Hand" TextDecorations="Underline" MouseLeftButtonUp="TxtAutoBackupPath_Click" ToolTip="Klasörü Aç" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- TEHLİKELİ İŞLEMLER (Artık Row 4) -->
            <Border Grid.Row="4" Style="{StaticResource SettingsSectionStyle}" BorderBrush="#DC2626">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0 0 0 16">
                        <Border Background="#FEE2E2" CornerRadius="16" Width="32" Height="32" Margin="0 0 12 0">
                            <TextBlock Text="⚠️" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Tehlikeli İşlemler" FontFamily="{DynamicResource FontBody}" FontSize="18" FontWeight="Bold" Foreground="#DC2626" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Margin="44 0 0 0">
                        <TextBlock Text="Tüm verileri silerek uygulamayı ilk kurulduğu haline döndürür. Bu işlem GERİ ALINAMAZ!" Foreground="{DynamicResource ColorOnSurfaceVariant}" FontSize="14" TextWrapping="Wrap" Margin="0 0 0 12"/>
                        
                        <Button Height="44" Padding="16 0" Background="#DC2626" Foreground="White" BorderThickness="0" HorizontalAlignment="Left" Command="{Binding FactoryResetCommand}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}" x:Name="Bg">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🗑️ " FontSize="16" VerticalAlignment="Center"/>
                                            <TextBlock Text="Fabrika Ayarlarına Dön" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="#991B1B"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- KAYDET BUTONU -->
            <StackPanel Grid.Row="5" Margin="0 16 0 32">
                <Border BorderBrush="{DynamicResource ColorOutlineVariant}" BorderThickness="0 1 0 0" Margin="0 0 0 24"/>
                <Button Style="{StaticResource SaveButtonStyle}" Height="50" Width="200" HorizontalAlignment="Left" Command="{Binding SaveSettingsCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="💾 " FontSize="16" VerticalAlignment="Center"/>
                        <TextBlock Text="Ayarları Kaydet" FontSize="16" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            
        </Grid>
    </ScrollViewer>
</UserControl>
