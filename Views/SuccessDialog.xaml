<Window x:Class="PosApp.Views.SuccessDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="İşlem Başarılı" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" Background="Transparent" 
        ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True" FontFamily="Segoe UI" ShowInTaskbar="False">
    
    <Border Background="White" CornerRadius="16" Margin="20" Padding="30">
        <Border.Effect><DropShadowEffect Color="#B0BEC5" BlurRadius="20" ShadowDepth="5" Opacity="0.4"/></Border.Effect>
        
        <StackPanel>
            <!-- Checkmark / Success Icon -->
            <Grid HorizontalAlignment="Center" Margin="0 0 0 20">
                <Ellipse Width="70" Height="70" Fill="#E8F8F5"/>
                <TextBlock Text="✓" FontSize="36" FontWeight="Bold" Foreground="#2ECC71" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>

            <!-- Title -->
            <TextBlock x:Name="TxtTitle" Text="İşlem Başarılı!" FontSize="24" FontWeight="Bold" Foreground="#2C3E50" HorizontalAlignment="Center" Margin="0 0 0 10"/>
            
            <!-- Message Body -->
            <TextBlock x:Name="TxtMessage" FontSize="16" Foreground="#7F8C8D" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" Margin="0 0 0 25" LineHeight="24"/>
            
            <Separator Background="#F4F6F9" Margin="0 0 0 20"/>
            
            <!-- Details Grid (Optional, can be used for Receipt No, etc.) -->
            <Grid x:Name="GridDetails" Margin="0 0 0 25">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Tutar:" Foreground="#95A5A6" FontSize="14" FontWeight="SemiBold" Margin="0 0 15 10"/>
                <TextBlock x:Name="TxtDetailAmount" Grid.Row="0" Grid.Column="1" Text="₺0.00" Foreground="#2C3E50" FontSize="15" FontWeight="Bold" HorizontalAlignment="Right" Margin="0 0 0 10"/>
                
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Ödeme Şekli:" Foreground="#95A5A6" FontSize="14" FontWeight="SemiBold" Margin="0 0 15 10"/>
                <TextBlock x:Name="TxtDetailPayment" Grid.Row="1" Grid.Column="1" Text="Nakit" Foreground="#2C3E50" FontSize="15" FontWeight="Bold" HorizontalAlignment="Right" Margin="0 0 0 10"/>
                
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Fiş No:" Foreground="#95A5A6" FontSize="14" FontWeight="SemiBold" Margin="0 0 15 0"/>
                <TextBlock x:Name="TxtDetailReceipt" Grid.Row="2" Grid.Column="1" Text="FIS000000" Foreground="#2C3E50" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0 0 0 0"/>
            </Grid>
            
            <!-- OK Button -->
            <Button Content="Tamam" Padding="0 15" Background="Black" Foreground="White" FontSize="16" FontWeight="Bold" BorderThickness="0" Click="BtnOk_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Cursor" Value="Hand"/>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Border>
</Window>
